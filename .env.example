# KeySafe Environment Configuration
# Copy to .env and fill in values. Never commit .env.

# Generate with: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Set to True only for local development. If unset/False and DJANGO_SECRET_KEY
# is missing, the server refuses to start rather than run insecurely.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database: leave empty for SQLite (development).
# For production / Supabase PostgreSQL (TLS required):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require

# CORS / Frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Session / JWT
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# Security
ACCOUNT_LOCKOUT_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
SESSION_IDLE_TIMEOUT_MINUTES=15
VAULT_IDLE_LOCK_MINUTES=15

# Email OTP (2FA + forgot password)
# In DEBUG, emails print to the Django console by default.
# For real Gmail delivery, create an App Password and set:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your.gmail@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password
# DEFAULT_FROM_EMAIL=KeySafe <your.gmail@gmail.com>
